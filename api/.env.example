APP_NAME=Fashion-Store-API
APP_ENV=local
APP_VERSION=0.0.0
GIT_COMMIT=
APP_KEY=
# Generate a local signing secret with `php artisan jwt:secret`.
JWT_SECRET=
JWT_TTL=15
APP_DEBUG=true
APP_URL=http://localhost:8000
ADMIN_URL=http://localhost:5174
STOREFRONT_URL=http://localhost:5173
# Storefront WebAuthn: production must set RP ID to the storefront hostname and allow its exact HTTPS origin(s).
STORE_WEBAUTHN_RP_ID=localhost
STORE_WEBAUTHN_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Exact browser origins allowed to call the credentialed API; production must replace these local origins.
API_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175
# Authenticated media uploads per minute, limited by both IP address and account.
API_UPLOADS_PER_MINUTE=20
# Public Storefront API requests per minute per client IP.
API_PUBLIC_REQUESTS_PER_MINUTE=60
# Optional comma-separated exact proxy IPs/CIDRs; leave blank for direct connections.
TRUSTED_PROXIES=
# Optional admin account notification/linking integration. Never commit actual credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fashion_store
DB_USERNAME=root
DB_PASSWORD=1234

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
BACKUP_ARCHIVE_PASSWORD=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local bootstrap only: the first database seed creates this account as super-admin.
# Keep real credentials in api/.env and do not commit them.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
STORE_DEMO_CUSTOMER_EMAIL=demo.customer@example.test
# Local demo login only; use a unique secret outside local development.
STORE_DEMO_CUSTOMER_PASSWORD=StoreDemo123!
STORE_DEMO_STAFF_EMAIL=demo.staff@example.test
# Local demo login only; the staff account is seeded only in local/testing.
STORE_DEMO_STAFF_PASSWORD=StoreDemo123!
STORE_DEFAULT_SHIPPING_FEE=30000
STORE_FREE_SHIPPING_THRESHOLD=1500000
# Defaults on for APP_ENV=local/testing/uat and off otherwise; uncomment to override.
# STORE_PUBLIC_REGISTRATION_ENABLED=true

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional Twilio SMS for customer back-in-stock alerts. Phone alerts remain hidden until all three values are set.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional Zalo ZBS Template Message. Use approved template IDs and matching variable names.
ZALO_ZBS_APP_ID=
ZALO_ZBS_SECRET_KEY=
# Bootstrap refresh token only; the API stores each rotated token encrypted in settings.
ZALO_ZBS_REFRESH_TOKEN=
ZALO_ZBS_TEMPLATE_ORDER_PLACED=
ZALO_ZBS_TEMPLATE_ORDER_SHIPPED=
ZALO_ZBS_TEMPLATE_PRICE_DROP=
ZALO_ZBS_TEMPLATE_PROMOTION=

# Generate with: php artisan webpush:vapid
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
