# Optional. When omitted, the API uses the current browser hostname on port 8000.
# Use a same-site API origin for refresh cookies when setting this explicitly.
# VITE_API_URL=http://localhost:8000/api/v1
# Optional tile template for the lazy-loaded /stores map. Production may set a contracted OSM-derived provider.
# Leave the default browser Referer behavior enabled when using the public OpenStreetMap tile server.
# VITE_STOREFRONT_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Used only by npm run build:seo. Replace both with public release origins for deployment.
STOREFRONT_PRERENDER_API_URL=http://localhost:8000/api/v1
STOREFRONT_PRERENDER_SITE_URL=http://localhost:5173
